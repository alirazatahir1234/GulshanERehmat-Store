{% doc %}
  @prompt
    I want to use Existing Menu in this section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-menu-navigation-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-menu-nav-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    justify-content: {{ block.settings.alignment }};
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .ai-menu-nav-item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-menu-nav-link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-family: {% if block.settings.font_family == 'body' %}var(--font-body){% elsif block.settings.font_family == 'heading' %}var(--font-heading){% elsif block.settings.font_family == 'accent' %}var(--font-accent){% else %}var(--font-subheading){% endif %};
    font-weight: {{ block.settings.font_weight }};
    text-transform: {% if block.settings.text_transform == 'uppercase' %}uppercase{% else %}none{% endif %};
    transition: color 0.2s ease;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    border-radius: {{ block.settings.link_border_radius }}px;
  }

  .ai-menu-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.link_hover_background }};
  }

  .ai-menu-nav-link-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_text_color }};
    background-color: {{ block.settings.active_background_color }};
  }

  .ai-menu-empty-state-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    color: #999;
    font-size: 14px;
    background-color: #f9f9f9;
    border-radius: 8px;
  }

  .ai-menu-empty-state-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-menu-empty-state-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ai-menu-navigation-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-menu-nav-list-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'column' %}
        flex-direction: column;
      {% endif %}
      gap: {{ block.settings.mobile_item_spacing }}px;
    }

    .ai-menu-nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<nav class="ai-menu-navigation-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
    <ul class="ai-menu-nav-list-{{ ai_gen_id }}">
      {% for link in block.settings.menu.links %}
        <li class="ai-menu-nav-item-{{ ai_gen_id }}">
          <a
            href="{{ link.url }}"
            class="ai-menu-nav-link-{{ ai_gen_id }} {% if link.active %}active{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="ai-menu-empty-state-{{ ai_gen_id }}">
      <p>Select a menu to display navigation links</p>
      <p><a href="/admin/menus" target="_blank">Create or manage menus</a></p>
    </div>
  {% endif %}
</nav>

