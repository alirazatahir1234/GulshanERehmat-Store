{
  "sections": {
    "ger_collection_hero": {
      "type": "ger-collection-hero",
      "settings": {
        "eyebrow": "Fresh styles just landed",
        "heading": "",
        "subtitle": "Discover the latest fabrics, designs and colors \u2014 made for your next signature look.",
        "script_text": "New Looks New Stories.",
        "show_gradient": true
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "vertical",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": true,
            "show_filter_label": true,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 28
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 12,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h5",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 10,
                "padding-block-end": 0,
                "padding-inline-start": 10,
                "padding-inline-end": 10
              },
              "blocks": {}
            },
            "product_meta": {
              "type": "_ger-product-meta",
              "settings": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "0.9375rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 4,
                "padding-block-end": 8,
                "padding-inline-start": 10,
                "padding-inline-end": 10
              },
              "blocks": {}
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "name": "Add to cart",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 10,
                "padding-inline-end": 10
              },
              "blocks": {}
            }
          },
          "block_order": [
            "card-gallery",
            "product_title",
            "product_meta",
            "price",
            "buy_buttons"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "small",
        "mobile_product_card_size": "small",
        "enable_infinite_scroll": false,
        "products_per_page": 12,
        "product_grid_width": "centered",
        "full_width_on_mobile": true,
        "columns_gap_horizontal": 16,
        "columns_gap_vertical": 24,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 48
      }
    },
    "ger_benefits": {
      "type": "ger-benefits-bar",
      "blocks": {
        "benefit_shipping": {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "title": "Free Shipping",
            "text": "On Orders Above Rs. 5,000"
          }
        },
        "benefit_quality": {
          "type": "benefit",
          "settings": {
            "icon": "quality",
            "title": "Premium Quality",
            "text": "Fabrics You Can Trust"
          }
        },
        "benefit_secure": {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "title": "Secure Payment",
            "text": "100% Safe Checkout"
          }
        },
        "benefit_returns": {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "title": "Easy Returns",
            "text": "Hassle-Free Support"
          }
        }
      },
      "block_order": [
        "benefit_shipping",
        "benefit_quality",
        "benefit_secure",
        "benefit_returns"
      ],
      "settings": {}
    }
  },
  "order": [
    "ger_collection_hero",
    "main",
    "ger_benefits"
  ]
}
