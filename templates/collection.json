{
  "sections": {
    "ger_collection_hero": {
      "type": "ger-collection-hero",
      "settings": {
        "eyebrow": "MEN COLLECTION",
        "heading": "",
        "subtitle": "Discover the latest fabrics, designs and colors — made for your next signature look.",
        "script_text": "",
        "show_gradient": true,
        "show_side_panel": true,
        "side_label": "Summer Collection",
        "side_tagline": "Lighter fabrics, brighter days, bolder you"
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "vertical",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": true,
            "show_filter_label": true,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 28
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 10,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_meta": {
              "type": "_ger-product-meta",
              "settings": {}
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "0.9375rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": false,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 4,
                "padding-block-end": 4,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "name": "Add to cart",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "card-gallery",
            "product_meta",
            "product_title",
            "price",
            "buy_buttons"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "large",
        "mobile_product_card_size": "large",
        "enable_infinite_scroll": false,
        "products_per_page": 12,
        "product_grid_width": "centered",
        "full_width_on_mobile": true,
        "columns_gap_horizontal": 28,
        "columns_gap_vertical": 36,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 32
      }
    },
    "ger_collection_description": {
      "type": "ger-collection-description",
      "settings": {
        "fallback_text": "<p>Experience comfort and style with our premium Wash n Wear collection for men. High-quality fabrics, elegant designs and versatile colors - perfect for every occasion. Discover the finest fabrics only at Gulshan-e-Rehmat.</p>"
      }
    },
    "ger_newsletter": {
      "type": "ger-newsletter",
      "settings": {
        "heading": "Join the Gulshan-e-Rehmat Family",
        "text": "Subscribe to get exclusive offers and updates.",
        "placeholder": "Your email address",
        "button_label": "Subscribe",
        "success_message": "Thanks for subscribing!"
      }
    }
  },
  "order": [
    "ger_collection_hero",
    "main",
    "ger_collection_description",
    "ger_newsletter"
  ]
}
