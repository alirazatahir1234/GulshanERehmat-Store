/*
 * ------------------------------------------------------------
 * GER Product Detail Page — custom main section.
 * Header/footer groups remain unchanged.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "ger-product",
      "settings": {
        "show_sticky_bar": true
      }
    },
    "ger_product_recommendations": {
      "type": "ger-product-recommendations",
      "settings": {
        "heading": "YOU MAY ALSO LIKE",
        "recommendation_type": "related",
        "max_products": 4
      }
    },
    "ger_recently_viewed": {
      "type": "ger-recently-viewed",
      "settings": {
        "heading": "RECENTLY VIEWED"
      }
    }
  },
  "order": [
    "main",
    "ger_product_recommendations",
    "ger_recently_viewed"
  ]
}
