{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-testimonials" {{ section.shopify_attributes }}>
  <div class="ger-container ger-testimonials__wrap">
    <div class="ger-testimonials__header ger-fade-in">
      {% if section.settings.heading != blank %}
        <h2 class="ger-testimonials__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ger-testimonials__grid">
      {% for block in section.blocks %}
        <blockquote class="ger-testimonials__card ger-fade-in" {{ block.shopify_attributes }}>
          {% if block.settings.quote != blank %}
            <p class="ger-testimonials__quote">“{{ block.settings.quote }}”</p>
          {% endif %}
          <div class="ger-testimonials__stars" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}
              <span aria-hidden="true">★</span>
            {% endfor %}
          </div>
          {% if block.settings.author != blank %}
            <cite class="ger-testimonials__author">— {{ block.settings.author }}</cite>
          {% endif %}
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Testimonials",
  "tag": "section",
  "class": "ger-testimonials-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Beautiful fabric and amazing quality. Exactly as shown in the pictures."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ayesha K."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "Beautiful fabric and amazing quality. Exactly as shown in the pictures.",
            "author": "Ayesha K."
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Fast delivery and premium quality. Will definitely shop again!",
            "author": "Saba M."
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Gulshan-e-Rehmat never disappoints. Truly elegant fabrics.",
            "author": "Mariam R."
          }
        }
      ]
    }
  ]
}
{% endschema %}
