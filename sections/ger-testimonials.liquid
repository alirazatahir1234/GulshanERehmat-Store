{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section
  class="ger-section ger-testimonials"
  data-ger-testimonials
  {{ section.shopify_attributes }}
>
  <div class="ger-container">
    <div class="ger-testimonials__header ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-heading ger-heading--md">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ger-testimonials__track-wrap ger-fade-in">
      {% for block in section.blocks %}
        <blockquote
          class="ger-testimonials__slide{% if forloop.first %} is-active{% endif %}"
          data-ger-testimonial
          {{ block.shopify_attributes }}
        >
          {% if block.settings.quote != blank %}
            <p class="ger-testimonials__quote">“{{ block.settings.quote }}”</p>
          {% endif %}
          {% if block.settings.author != blank %}
            <cite class="ger-testimonials__author">{{ block.settings.author }}</cite>
          {% endif %}
        </blockquote>
      {% endfor %}

      {% if section.blocks.size > 1 %}
        <div class="ger-testimonials__nav">
          {% for block in section.blocks %}
            <button
              type="button"
              class="ger-testimonials__dot{% if forloop.first %} is-active{% endif %}"
              data-ger-testimonial-dot
              aria-label="Show testimonial {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Testimonials",
  "tag": "section",
  "class": "ger-testimonials-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The fabric quality exceeded my expectations. Soft, elegant, and perfect for my wedding outfit."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ayesha K."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "The fabric quality exceeded my expectations. Soft, elegant, and perfect for my wedding outfit.",
            "author": "Ayesha K."
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Beautiful prints and excellent service. Gulshan E Rehmat is my go-to for unstitched fabrics.",
            "author": "Sara M."
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Men's suiting was premium and the delivery was quick. Highly recommended.",
            "author": "Imran R."
          }
        }
      ]
    }
  ]
}
{% endschema %}
