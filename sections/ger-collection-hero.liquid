{{ 'ger-collection.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@400;500;600&family=Great+Vibes&display=swap"
>

{%- liquid
  assign kafoor_page = false
  assign wash_wear_parent = false
  assign summer_fabric_page = false
  assign ger_plp_master = false
  assign ger_plp_label = collection.title
  assign ger_plp_subtitle = 'Premium Fabrics for Every Occasion'
  assign handle = collection.handle | default: ''

  if handle == 'men-wash-n-wear-kafoor-by-taiba' or handle == 'men-wash-n-wear-kafoor-by-taiba-life-line' or handle contains 'kafoor-by-taiba'
    assign kafoor_page = true
  endif

  if handle == 'men-summer-wash-n-wear' or handle == 'men-wash-n-wear' or handle == 'wash-n-wear' or handle == 'wash-and-wear'
    assign wash_wear_parent = true
    assign summer_fabric_page = true
    assign ger_plp_label = 'Wash & Wear'
    assign ger_plp_subtitle = 'Premium Fabrics for Every Occasion'
  endif

  if handle == 'men-summer-cotton'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Cotton'
    assign ger_plp_subtitle = 'Soft Everyday Essentials'
  endif

  if handle == 'men-summer-lawn'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Lawn'
    assign ger_plp_subtitle = 'Light & Breathable Fabrics'
  endif

  if handle == 'men-summer-imported'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Imported'
    assign ger_plp_subtitle = 'Curated International Fabrics'
  endif

  if handle == 'men-summer-embroidered'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Embroidered Collection'
    assign ger_plp_subtitle = 'Detailed Craft for Special Occasions'
  endif

  if wash_wear_parent == false and kafoor_page == false and summer_fabric_page == false
    assign title_down = collection.title | downcase | default: ''
    if title_down contains 'wash' and title_down contains 'wear'
      unless title_down contains 'kafoor' or title_down contains 'life line'
        assign wash_wear_parent = true
        assign summer_fabric_page = true
        assign ger_plp_label = 'Wash & Wear'
      endunless
    endif
  endif

  if summer_fabric_page and kafoor_page == false
    assign ger_plp_master = true
  endif
-%}

{%- if kafoor_page -%}
  {% render 'ger-collection-banner' %}
{%- elsif ger_plp_master -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = ger_plp_label | append: ' Collection'
  endif
  assign subtitle = ger_plp_subtitle
  if wash_wear_parent and section.settings.wash_subtitle != blank
    assign subtitle = section.settings.wash_subtitle
  endif
  assign intro = section.settings.wash_intro
  if intro == blank and wash_wear_parent
    assign intro = 'Discover premium Wash & Wear fabrics from trusted brands, designed for comfort, durability and effortless everyday style.'
  endif
  if intro == blank and collection.description != blank
    assign intro = collection.description | strip_html | truncate: 180
  endif
  assign script_text = section.settings.wash_script | default: 'Style in Every Season'

  assign model_image = section.settings.model_image
  if model_image == blank and collection.image
    assign model_image = collection.image
  endif
-%}

<section
  class="ger-collection-hero ger-collection-hero--wash ger-collection-hero--plp{% if section.settings.show_gradient %} ger-collection-hero--gradient{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="ger-collection-hero__inner ger-collection-hero__inner--wash">
    <div class="ger-collection-hero__copy">
      {% render 'ger-collection-breadcrumb', collection: collection %}

      <h1 class="ger-collection-hero__heading">{{ heading }}</h1>
      {% if subtitle != blank %}
        <p class="ger-collection-hero__subtitle">{{ subtitle }}</p>
      {% endif %}
      {% if intro != blank %}
        <p class="ger-collection-hero__intro">{{ intro }}</p>
      {% endif %}

      <div class="ger-collection-hero__features ger-collection-hero__features--wash" aria-label="Collection highlights">
        <div class="ger-collection-hero__feature ger-collection-hero__feature--stack">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M12 3c-2.5 3.5-6 5.2-6 9a6 6 0 0012 0c0-3.8-3.5-5.5-6-9z"/>
            </svg>
          </span>
          <span class="ger-collection-hero__feature-label">Breathable</span>
          <span class="ger-collection-hero__feature-hint">All Day Comfort</span>
        </div>
        <div class="ger-collection-hero__feature ger-collection-hero__feature--stack">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"/>
            </svg>
          </span>
          <span class="ger-collection-hero__feature-label">Durable</span>
          <span class="ger-collection-hero__feature-hint">Long Lasting</span>
        </div>
        <div class="ger-collection-hero__feature ger-collection-hero__feature--stack">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M12 3l2.2 4.5L19 8.5l-3.5 3.4.8 4.8L12 14.8 7.7 16.7l.8-4.8L5 8.5l4.8-1z"/>
            </svg>
          </span>
          <span class="ger-collection-hero__feature-label">Premium Quality</span>
          <span class="ger-collection-hero__feature-hint">Fine Finish</span>
        </div>
        <div class="ger-collection-hero__feature ger-collection-hero__feature--stack">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M4 7h16M4 12h16M4 17h10"/>
            </svg>
          </span>
          <span class="ger-collection-hero__feature-label">Wide Range</span>
          <span class="ger-collection-hero__feature-hint">For Every Style</span>
        </div>
      </div>
    </div>

    <div class="ger-collection-hero__visual">
      <div class="ger-collection-hero__media">
        {% if model_image != blank %}
          {{
            model_image
            | image_url: width: 1200
            | image_tag:
              class: 'ger-collection-hero__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 42vw, 90vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: model_image.alt | default: heading
          }}
        {% else %}
          <img
            class="ger-collection-hero__image"
            src="{{ 'ger-promo-hero-right-fabrics.png' | asset_url }}"
            alt="{{ heading | escape }}"
            width="768"
            height="512"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {% endif %}
        {% if script_text != blank %}
          <span class="ger-collection-hero__script">{{ script_text | newline_to_br }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{%- else -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'MEN COLLECTION'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = collection.title
  endif
  assign subtitle = section.settings.subtitle
  if subtitle == blank
    assign subtitle = 'Discover the latest fabrics, designs and colors — made for your next signature look.'
  endif
  if subtitle == blank and collection.description != blank
    assign subtitle = collection.description | strip_html | truncate: 160
  endif

  assign model_image = section.settings.model_image
  if model_image == blank and collection.image
    assign model_image = collection.image
  endif
  if model_image == blank and collection.products_count > 0
    assign first_product = collection.products.first
    if first_product.featured_media
      assign model_image = first_product.featured_media.preview_image
    elsif first_product.featured_image
      assign model_image = first_product.featured_image
    endif
  endif

  assign side_label = section.settings.side_label | default: 'Summer Collection'
  assign side_tagline = section.settings.side_tagline | default: 'Lighter fabrics, brighter days, bolder you'
  assign script_text = section.settings.script_text | default: 'New Looks New Stories.'
-%}

<section
  class="ger-collection-hero{% if section.settings.show_gradient %} ger-collection-hero--gradient{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="ger-collection-hero__flora ger-collection-hero__flora--left" aria-hidden="true">
    {% if section.settings.floral_left != blank %}
      <img
        src="{{ section.settings.floral_left | image_url: width: 320 }}"
        alt=""
        width="160"
        height="160"
        loading="lazy"
        decoding="async"
      >
    {% else %}
      <svg viewBox="0 0 120 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M40 180c10-40 8-70-10-110 22 18 40 48 38 90" stroke="currentColor" stroke-width="1.2"/>
        <path d="M30 95c18-8 34-4 48 12-20 2-36 10-48 24" stroke="currentColor" stroke-width="1.2"/>
        <path d="M22 70c14-16 32-18 50-8-16 10-30 18-42 22" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="28" cy="68" r="3" fill="currentColor" opacity="0.35"/>
        <circle cx="48" cy="102" r="2.5" fill="currentColor" opacity="0.3"/>
      </svg>
    {% endif %}
  </div>
  <div class="ger-collection-hero__flora ger-collection-hero__flora--right" aria-hidden="true">
    {% if section.settings.floral_right != blank %}
      <img
        src="{{ section.settings.floral_right | image_url: width: 320 }}"
        alt=""
        width="160"
        height="160"
        loading="lazy"
        decoding="async"
      >
    {% else %}
      <svg viewBox="0 0 120 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M80 20c-10 40-8 70 10 110-22-18-40-48-38-90" stroke="currentColor" stroke-width="1.2"/>
        <path d="M90 105c-18 8-34 4-48-12 20-2 36-10 48-24" stroke="currentColor" stroke-width="1.2"/>
        <path d="M98 130c-14 16-32 18-50 8 16-10 30-18 42-22" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="92" cy="132" r="3" fill="currentColor" opacity="0.35"/>
        <circle cx="72" cy="98" r="2.5" fill="currentColor" opacity="0.3"/>
      </svg>
    {% endif %}
  </div>

  <div class="ger-collection-hero__inner">
    <div class="ger-collection-hero__copy">
      {% if eyebrow != blank %}
        <p class="ger-collection-hero__eyebrow">{{ eyebrow }}</p>
      {% endif %}
      {% if heading != blank %}
        <h1 class="ger-collection-hero__heading">{{ heading }}</h1>
      {% endif %}
      {% if subtitle != blank %}
        <p class="ger-collection-hero__subtitle">{{ subtitle }}</p>
      {% endif %}

      <div class="ger-collection-hero__features" aria-label="Collection highlights">
        <div class="ger-collection-hero__feature">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
              <path d="M12 3c-2.5 3.5-6 5.2-6 9a6 6 0 0012 0c0-3.8-3.5-5.5-6-9z"/>
              <path d="M9.5 14.5c.8 1.2 2 1.8 2.5 2"/>
            </svg>
          </span>
          <span>Premium Fabrics</span>
        </div>
        <div class="ger-collection-hero__feature">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
            </svg>
          </span>
          <span>Trendy Designs</span>
        </div>
        <div class="ger-collection-hero__feature">
          <span class="ger-collection-hero__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M6.3 6.3l-1.4-1.4M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/>
            </svg>
          </span>
          <span>Season's Best</span>
        </div>
      </div>
    </div>

    <div class="ger-collection-hero__visual">
      <div class="ger-collection-hero__media">
        {% if model_image != blank %}
          {{
            model_image
            | image_url: width: 1200
            | image_tag:
              class: 'ger-collection-hero__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 38vw, 90vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: model_image.alt | default: heading
          }}
        {% else %}
          <div class="ger-collection-hero__placeholder" aria-hidden="true"></div>
        {% endif %}
        {% if script_text != blank %}
          <span class="ger-collection-hero__script">{{ script_text | newline_to_br }}</span>
        {% endif %}
      </div>

      {% if section.settings.show_side_panel %}
        <aside class="ger-collection-hero__side" aria-label="{{ side_label }}">
          <p class="ger-collection-hero__side-label">{{ side_label }}</p>
          <span class="ger-collection-hero__side-rule" aria-hidden="true"></span>
          <p class="ger-collection-hero__side-tagline">{{ side_tagline }}</p>
          <span class="ger-collection-hero__side-arrow" aria-hidden="true">→</span>
        </aside>
      {% endif %}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "GER Collection hero",
  "tag": "section",
  "class": "ger-collection-hero-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "MEN COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "info": "Leave blank to use the collection title (or Wash & Wear Collection on that page)."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Discover the latest fabrics, designs and colors — made for your next signature look."
    },
    {
      "type": "text",
      "id": "wash_subtitle",
      "label": "Wash & Wear subtitle",
      "default": "Premium Fabrics for Every Occasion"
    },
    {
      "type": "textarea",
      "id": "wash_intro",
      "label": "Wash & Wear intro",
      "default": "Discover premium Wash & Wear fabrics from trusted brands, designed for comfort, durability and effortless everyday style."
    },
    {
      "type": "text",
      "id": "wash_script",
      "label": "Wash & Wear script overlay",
      "default": "Style in Every Season"
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Script overlay text",
      "default": "New Looks New Stories."
    },
    {
      "type": "image_picker",
      "id": "model_image",
      "label": "Hero model image",
      "info": "Falls back to collection image, then fabric asset on Wash & Wear."
    },
    {
      "type": "image_picker",
      "id": "floral_left",
      "label": "Decorative floral (left)"
    },
    {
      "type": "image_picker",
      "id": "floral_right",
      "label": "Decorative floral (right)"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Soft cream and pink gradient",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_side_panel",
      "label": "Show side collection panel",
      "default": true
    },
    {
      "type": "text",
      "id": "side_label",
      "label": "Side panel label",
      "default": "Summer Collection"
    },
    {
      "type": "textarea",
      "id": "side_tagline",
      "label": "Side panel tagline",
      "default": "Lighter fabrics, brighter days, bolder you"
    }
  ],
  "presets": [
    {
      "name": "GER Collection hero"
    }
  ]
}
{% endschema %}
