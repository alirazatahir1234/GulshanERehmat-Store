{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<div class="ger-top-bar" {{ section.shopify_attributes }}>
  <div class="ger-container ger-top-bar__inner">
    {% for block in section.blocks %}
      {% liquid
        assign align = block.settings.align | default: 'center'
        assign show_icon = block.settings.show_icon
        assign icon_type = block.settings.icon | default: 'none'
      %}
      <p
        class="ger-top-bar__item ger-top-bar__item--{{ align }}"
        {{ block.shopify_attributes }}
      >
        {% if show_icon and icon_type != 'none' %}
          <span class="ger-top-bar__icon" aria-hidden="true">
            {% case icon_type %}
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                  <path d="M1 7h12v9H1z"/>
                  <path d="M13 10h4l3 3v3h-7v-6z"/>
                  <circle cx="5.5" cy="17.5" r="1.5"/>
                  <circle cx="16.5" cy="17.5" r="1.5"/>
                </svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                  <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>
                </svg>
              {% when 'heart' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                  <path d="M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z"/>
                </svg>
            {% endcase %}
          </span>
        {% endif %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {% else %}
          <span>{{ block.settings.text }}</span>
        {% endif %}
      </p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "GER Top bar",
  "tag": "section",
  "class": "ger-top-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping on Orders Above Rs. 5,000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Top bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Elegance in Every Thread",
            "align": "left"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Easy Returns | Secure Payment | Premium Fabrics | PKR",
            "align": "right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
