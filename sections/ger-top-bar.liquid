{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}

<div class="ger-top-bar" {{ section.shopify_attributes }}>
  <div class="ger-container ger-top-bar__inner">
    {% for block in section.blocks %}
      <p class="ger-top-bar__item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {% else %}
          {{ block.settings.text }}
        {% endif %}
      </p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "GER Top bar",
  "tag": "section",
  "class": "ger-top-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over Rs. 5,000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Top bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over Rs. 5,000"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Authentic fabrics · Premium quality"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Easy returns within 7 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
