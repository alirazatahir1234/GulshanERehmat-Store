{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-featured" {{ section.shopify_attributes }}>
  <div class="ger-container ger-featured__wrap">
    <div class="ger-featured__header ger-fade-in">
      <div class="ger-featured__intro">
        {% if section.settings.heading != blank %}
          <h2 class="ger-featured__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="ger-featured__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      {% if section.settings.view_all_label != blank %}
        <a
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          class="ger-featured__view-all"
        >
          {{ section.settings.view_all_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    <div class="ger-featured__scroller" data-ger-featured>
      <div class="ger-featured__grid">
        {% for block in section.blocks %}
          {% liquid
            assign product = block.settings.product
            assign card_title = block.settings.title
            assign card_url = block.settings.link
            assign card_price = block.settings.price
            assign card_image = block.settings.image
            assign rating = block.settings.rating | default: 5
            assign reviews = block.settings.reviews | default: 0
            assign wishlist_key = block.id

            if product != blank
              if card_title == blank
                assign card_title = product.title
              endif
              if card_url == blank
                assign card_url = product.url
              endif
              if card_price == blank
                assign card_price = product.price | money
              endif
              if card_image == blank and product.featured_media != blank
                assign card_image = product.featured_media.preview_image
              endif
              assign wishlist_key = product.id
            endif

            if card_url == blank
              assign card_url = routes.all_products_collection_url
            endif

            assign fallback_index = forloop.index
            if fallback_index > 6
              assign fallback_index = fallback_index | modulo: 6
              if fallback_index == 0
                assign fallback_index = 6
              endif
            endif
            assign fallback_asset = 'ger-fabric-' | append: fallback_index | append: '.jpg'
          %}

          <article class="ger-product-card" data-ger-product-card {{ block.shopify_attributes }}>
            <div class="ger-product-card__media">
              <a href="{{ card_url }}" class="ger-product-card__media-link" tabindex="-1" aria-hidden="true">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 400, 560, 800',
                      sizes: '(min-width: 990px) 16vw, (min-width: 750px) 28vw, 55vw',
                      alt: card_title,
                      class: 'ger-product-card__img'
                  }}
                {% else %}
                  <img
                    class="ger-product-card__img"
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ card_title | escape }}"
                    width="800"
                    height="800"
                    loading="lazy"
                  >
                {% endif %}
              </a>
              <button
                type="button"
                class="ger-product-card__wish"
                data-ger-wishlist
                data-wishlist-key="{{ wishlist_key }}"
                aria-label="Add {{ card_title | escape }} to wishlist"
                aria-pressed="false"
              >
                <svg class="ger-product-card__wish-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path
                    class="ger-product-card__wish-outline"
                    d="M12 20s-7.2-4.35-9.4-8.2C1.2 9.1 2.4 6 5.4 5.3c1.7-.4 3.4.3 4.4 1.6C10.8 5.6 12.5 4.9 14.2 5.3c3 .7 4.2 3.8 2.8 6.5C19.2 15.65 12 20 12 20z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path
                    class="ger-product-card__wish-fill"
                    d="M12 20s-7.2-4.35-9.4-8.2C1.2 9.1 2.4 6 5.4 5.3c1.7-.4 3.4.3 4.4 1.6C10.8 5.6 12.5 4.9 14.2 5.3c3 .7 4.2 3.8 2.8 6.5C19.2 15.65 12 20 12 20z"
                    fill="currentColor"
                  />
                </svg>
              </button>
            </div>

            <div class="ger-product-card__body">
              {% if card_title != blank %}
                <h3 class="ger-product-card__title">
                  <a href="{{ card_url }}">{{ card_title }}</a>
                </h3>
              {% endif %}
              {% if card_price != blank %}
                <p class="ger-product-card__price">
                  {% if product != blank and block.settings.price == blank %}
                    {{ card_price }}
                  {% else %}
                    {{ card_price }}
                  {% endif %}
                </p>
              {% endif %}
              <div class="ger-product-card__rating" aria-label="Rated {{ rating }} out of 5 from {{ reviews }} reviews">
                <span class="ger-product-card__stars" aria-hidden="true">
                  {% for i in (1..5) %}
                    <span class="ger-product-card__star{% if i <= rating %} is-on{% endif %}">★</span>
                  {% endfor %}
                </span>
                <span class="ger-product-card__reviews">({{ reviews }})</span>
              </div>
              {% if product != blank and product.selected_or_first_available_variant.available %}
                {% form 'product', product, class: 'ger-product-card__quick-form' %}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <button type="submit" name="add" class="ger-product-card__quick-add">
                    Quick Add
                  </button>
                {% endform %}
              {% elsif card_url != blank %}
                <a href="{{ card_url }}" class="ger-product-card__quick-add ger-product-card__quick-add--link">
                  Shop Now
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Featured fabrics",
  "tag": "section",
  "class": "ger-featured-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED FABRICS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Handpicked designs from our latest collection"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the product image when set"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to product title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price override",
          "info": "Optional. Example: Rs. 2,650. Leave blank to use product price."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "number",
          "id": "reviews",
          "label": "Review count",
          "default": 24
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Featured fabrics",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "title": "Graceful Purple Prints",
            "price": "Rs. 2,650",
            "rating": 5,
            "reviews": 24
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Modern Square Prints",
            "price": "Rs. 2,650",
            "rating": 5,
            "reviews": 18
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Classic Blue Florals",
            "price": "Rs. 2,750",
            "rating": 5,
            "reviews": 32
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Nature Inspired",
            "price": "Rs. 2,650",
            "rating": 5,
            "reviews": 19
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Royal Red Roses",
            "price": "Rs. 2,650",
            "rating": 5,
            "reviews": 15
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Vibrant Blooms",
            "price": "Rs. 2,750",
            "rating": 5,
            "reviews": 26
          }
        }
      ]
    }
  ]
}
{% endschema %}
