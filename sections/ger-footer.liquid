{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}

<section class="ger-footer" {{ section.shopify_attributes }}>
  <div class="ger-container ger-footer__wrap">
    <div class="ger-footer__grid">
      <div class="ger-footer__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag:
              loading: 'lazy',
              widths: '180, 240, 360',
              alt: shop.name,
              class: 'ger-footer__logo-img'
          }}
        {% else %}
          <img
            class="ger-footer__logo-img"
            src="{{ 'ger-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="304"
            height="220"
            loading="lazy"
          >
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p class="ger-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.women_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'women_link' %}
              {% liquid
                assign footer_link = block.settings.link
                if footer_link == blank
                  assign label_key = block.settings.label | downcase | strip
                  if label_key contains 'unstitched'
                    assign footer_col = collections['unstitched-summer-two-piece']
                    if footer_col == blank
                      assign footer_col = collections['unstitched']
                    endif
                  elsif label_key contains 'ready'
                    assign footer_col = collections['ready-to-wear']
                  elsif label_key contains 'wedding'
                    assign footer_col = collections['wedding-collection']
                  elsif label_key contains 'abaya'
                    assign footer_col = collections['abaya-collection']
                  else
                    assign footer_col = nil
                  endif
                  if footer_col != blank
                    assign footer_link = footer_col.url
                  endif
                endif
              %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ footer_link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.men_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'men_link' %}
              {% liquid
                assign footer_link = block.settings.link
                if footer_link == blank
                  assign label_key = block.settings.label | downcase | strip
                  if label_key contains 'summer'
                    assign footer_col = collections['men-summer']
                    if footer_col == blank
                      assign footer_col = collections['men-summer-collection']
                    endif
                  elsif label_key contains 'winter'
                    assign footer_col = collections['men-winter']
                    if footer_col == blank
                      assign footer_col = collections['men-winter-collection']
                    endif
                  elsif label_key contains 'waist'
                    assign footer_col = collections['men-waist-coats']
                  else
                    assign footer_col = nil
                  endif
                  if footer_col != blank
                    assign footer_link = footer_col.url
                  endif
                endif
              %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ footer_link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.care_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'care_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.social_heading }}</h3>
        <div class="ger-footer__social">
          {% if section.settings.instagram_url != blank %}
            <a
              href="{{ section.settings.instagram_url }}"
              class="ger-footer__social-link ger-footer__social-link--instagram"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <defs>
                  <radialGradient id="GerIgGradient-{{ section.id }}" cx="30%" cy="107%" r="150%">
                    <stop offset="0%" stop-color="#fdf497"/>
                    <stop offset="5%" stop-color="#fdf497"/>
                    <stop offset="45%" stop-color="#fd5949"/>
                    <stop offset="60%" stop-color="#d6249f"/>
                    <stop offset="90%" stop-color="#285AEB"/>
                  </radialGradient>
                </defs>
                <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#GerIgGradient-{{ section.id }})"/>
                <circle cx="12" cy="12" r="4.2" fill="none" stroke="#fff" stroke-width="1.7"/>
                <circle cx="17.4" cy="6.6" r="1.15" fill="#fff"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a
              href="{{ section.settings.facebook_url }}"
              class="ger-footer__social-link ger-footer__social-link--facebook"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="12" r="11" fill="#1877F2"/>
                <path fill="#fff" d="M13.5 8.2h1.7V6h-1.7c-2 0-3.3 1.2-3.3 3.3v1.4H8.7v2.2h1.5V18h2.3v-5.1h1.8l.3-2.2h-2.1V9.5c0-.7.3-1.3 1-1.3z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a
              href="{{ section.settings.tiktok_url }}"
              class="ger-footer__social-link ger-footer__social-link--tiktok"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="12" r="11" fill="#010101"/>
                <path fill="#25F4EE" d="M14.8 5.2c.4 1.5 1.5 2.7 3 3v2c-1.1 0-2.2-.3-3.1-.9v4.5c0 2.6-2.1 4.7-4.7 4.7S5.3 16.4 5.3 13.8s2.1-4.7 4.7-4.7c.3 0 .5 0 .8.1v2.1c-.2-.1-.5-.1-.8-.1-1.4 0-2.6 1.2-2.6 2.6s1.2 2.6 2.6 2.6 2.6-1.2 2.6-2.6V5.2h2.2z"/>
                <path fill="#FE2C55" d="M14.2 5.8c.4 1.5 1.5 2.7 3 3v2c-1.1 0-2.2-.3-3.1-.9v4.5c0 2.6-2.1 4.7-4.7 4.7S4.7 17 4.7 14.4s2.1-4.7 4.7-4.7c.3 0 .5 0 .8.1v2.1c-.2-.1-.5-.1-.8-.1-1.4 0-2.6 1.2-2.6 2.6s1.2 2.6 2.6 2.6 2.6-1.2 2.6-2.6V5.8h2.2z" opacity=".9"/>
                <path fill="#fff" d="M14.5 5.5c.4 1.5 1.5 2.7 3 3v2c-1.1 0-2.2-.3-3.1-.9v4.5c0 2.6-2.1 4.7-4.7 4.7S5 16.7 5 14.1s2.1-4.7 4.7-4.7c.3 0 .5 0 .8.1v2.1c-.2-.1-.5-.1-.8-.1-1.4 0-2.6 1.2-2.6 2.6s1.2 2.6 2.6 2.6 2.6-1.2 2.6-2.6V5.5h2.2z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a
              href="{{ section.settings.youtube_url }}"
              class="ger-footer__social-link ger-footer__social-link--youtube"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path fill="#FF0000" d="M23.5 7.2s-.2-1.6-.9-2.3c-.8-.9-1.8-.9-2.2-.9C17.5 3.8 12 3.8 12 3.8h0s-5.5 0-8.4.2c-.4 0-1.4 0-2.2.9-.7.7-.9 2.3-.9 2.3S.3 9.1.3 11v1.6c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.8.9 1.9.8 2.4.9 1.8.2 7.2.2 7.2.2s5.5 0 8.4-.2c.4-.1 1.4-.1 2.2-.9.7-.7.9-2.3.9-2.3s.2-1.9.2-3.8V11c0-1.9-.2-3.8-.2-3.8z"/>
                <path fill="#fff" d="M9.8 14.8V8.8l5.7 3-5.7 3z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a
              href="{{ section.settings.pinterest_url }}"
              class="ger-footer__social-link ger-footer__social-link--pinterest"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="12" r="11" fill="#E60023"/>
                <path fill="#fff" d="M12.1 6.2c-3.1 0-5.3 2.1-5.3 4.9 0 2.1 1.2 3.7 3.1 3.7.5 0 .9-.2 1-.6l.2-.8.4-1.4c.1-.2 0-.4-.2-.5-.4-.3-.7-.8-.7-1.4 0-1.4 1.1-2.7 2.9-2.7 1.6 0 2.7 1.1 2.7 2.7 0 1.9-1 3.4-2.4 3.4-.7 0-1.3-.6-1.1-1.3.2-.8.6-1.7.6-2.3 0-.5-.3-.9-.9-.9-.7 0-1.3.7-1.3 1.7 0 .6.2 1 .2 1L9.6 16c-.3 1.1 0 2.5 0 2.6 0 .1.1.1.1 0 .1-.2 1.3-1.7 1.5-2.7.2-.4.8-3 0-3.8-.1 0-.1-.1 0-.2.6-.6 1.5-.9 2.4-.9 2.5 0 4.2 1.8 4.2 4.1 0 2.5-1.6 4.7-4.4 4.7-2.4 0-4.2-1.7-4.2-4 0-.8.3-1.6.7-2.1.1-.1.1-.1 0-.2-.1.4-.2.7-.2 1.1 0 2.4 1.7 4.3 4.1 4.3 2.9 0 4.9-2.3 4.9-5.1 0-2.9-2.2-5.1-5.3-5.1z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ger-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Footer",
  "tag": "section",
  "class": "ger-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Leave empty to use the original GR logo asset."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "GULSHAN-E-REHMAT"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Elegance in Every Thread"
    },
    {
      "type": "text",
      "id": "women_heading",
      "label": "Women column heading",
      "default": "SHOP WOMEN"
    },
    {
      "type": "text",
      "id": "men_heading",
      "label": "Men column heading",
      "default": "SHOP MEN"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Customer care heading",
      "default": "CUSTOMER CARE"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "women_link",
      "name": "Women link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Unstitched" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "men_link",
      "name": "Men link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Summer Collection" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "care_link",
      "name": "Care link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Contact Us" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Footer",
      "blocks": [
        { "type": "women_link", "settings": { "label": "Unstitched" } },
        { "type": "women_link", "settings": { "label": "Ready to Wear" } },
        { "type": "women_link", "settings": { "label": "Wedding Collection" } },
        { "type": "women_link", "settings": { "label": "Abaya Collection" } },
        { "type": "men_link", "settings": { "label": "Summer Collection" } },
        { "type": "men_link", "settings": { "label": "Winter Collection" } },
        { "type": "men_link", "settings": { "label": "Waist Coats" } },
        { "type": "care_link", "settings": { "label": "Contact Us" } },
        { "type": "care_link", "settings": { "label": "Shipping Policy" } },
        { "type": "care_link", "settings": { "label": "Returns & Exchange" } },
        { "type": "care_link", "settings": { "label": "Privacy Policy" } }
      ]
    }
  ]
}
{% endschema %}
