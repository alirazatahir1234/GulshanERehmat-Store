{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}

<section class="ger-footer" {{ section.shopify_attributes }}>
  <div class="ger-container">
    <div class="ger-footer__grid">
      <div class="ger-footer__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 280
            | image_tag: loading: 'lazy', widths: '140, 200, 280', alt: shop.name
          }}
        {% else %}
          <p class="ger-footer__logo">{{ section.settings.brand_name }}</p>
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p class="ger-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.women_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'women_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.men_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'men_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.care_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'care_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.social_heading }}</h3>
        <div class="ger-footer__social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">TikTok</a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer">YouTube</a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ger-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      {% if section.settings.payment_note != blank %}
        <p>{{ section.settings.payment_note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Footer",
  "tag": "section",
  "class": "ger-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Gulshan E Rehmat"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Elegance in Every Thread — premium unstitched fabrics for women and men."
    },
    {
      "type": "text",
      "id": "women_heading",
      "label": "Women column heading",
      "default": "Shop Women"
    },
    {
      "type": "text",
      "id": "men_heading",
      "label": "Men column heading",
      "default": "Shop Men"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Customer care heading",
      "default": "Customer Care"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "payment_note",
      "label": "Payment note",
      "default": "Secure checkout"
    }
  ],
  "blocks": [
    {
      "type": "women_link",
      "name": "Women link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "New arrivals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "men_link",
      "name": "Men link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Summer"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "care_link",
      "name": "Care link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Contact"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Footer",
      "blocks": [
        { "type": "women_link", "settings": { "label": "New arrivals" } },
        { "type": "women_link", "settings": { "label": "Unstitched" } },
        { "type": "women_link", "settings": { "label": "Sale" } },
        { "type": "men_link", "settings": { "label": "Summer" } },
        { "type": "men_link", "settings": { "label": "Winter" } },
        { "type": "men_link", "settings": { "label": "Waist Coats" } },
        { "type": "care_link", "settings": { "label": "Contact" } },
        { "type": "care_link", "settings": { "label": "Shipping" } },
        { "type": "care_link", "settings": { "label": "Returns" } },
        { "type": "care_link", "settings": { "label": "Size guide" } }
      ]
    }
  ]
}
{% endschema %}
