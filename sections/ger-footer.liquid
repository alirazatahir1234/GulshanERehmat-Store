{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}

<section class="ger-footer" {{ section.shopify_attributes }}>
  <div class="ger-container ger-footer__wrap">
    <div class="ger-footer__grid">
      <div class="ger-footer__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag:
              loading: 'lazy',
              widths: '180, 240, 360',
              alt: shop.name,
              class: 'ger-footer__logo-img'
          }}
        {% else %}
          <img
            class="ger-footer__logo-img"
            src="{{ 'ger-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="304"
            height="220"
            loading="lazy"
          >
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p class="ger-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.women_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'women_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.men_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'men_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.care_heading }}</h3>
        <ul class="ger-footer__list">
          {% for block in section.blocks %}
            {% if block.type == 'care_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="ger-footer__col-title">{{ section.settings.social_heading }}</h3>
        <div class="ger-footer__social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.5 4c.6 2.2 2.2 3.8 4.5 4.3v2.6c-1.7-.1-3.2-.7-4.5-1.7v6.5c0 3.5-2.8 6.3-6.3 6.3S4 19.2 4 15.7 6.8 9.4 10.2 9.4c.4 0 .7 0 1.1.1v2.8c-.3-.1-.7-.2-1.1-.2-1.9 0-3.4 1.5-3.4 3.5s1.5 3.5 3.4 3.5 3.4-1.5 3.4-3.5V4h2.9z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 8.2s-.2-1.6-.8-2.3c-.8-.8-1.7-.8-2.1-.9C16.4 4.8 12 4.8 12 4.8h0s-4.4 0-7.1.2c-.4.1-1.3.1-2.1.9C2.2 6.6 2 8.2 2 8.2S1.8 10 1.8 11.9v1.7c0 1.9.2 3.7.2 3.7s.2 1.6.8 2.3c.8.8 1.9.8 2.4.9 1.7.2 7 .2 7 .2s4.4 0 7.1-.2c.4-.1 1.3-.1 2.1-.9.6-.7.8-2.3.8-2.3s.2-1.8.2-3.7v-1.7c0-1.9-.2-3.7-.2-3.7zM10 15.1V9.4l5.2 2.9L10 15.1z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 3C7 3 3.5 6.5 3.5 11.2c0 3.3 1.9 6.1 4.7 7.2-.1-.9-.1-2.3.1-3.3.2-.9 1.4-5.9 1.4-5.9s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-1 3.8-.3 1.1.6 2.1 1.7 2.1 2.1 0 3.5-2.6 3.5-5.8 0-2.4-1.6-4.2-4.6-4.2-3.3 0-5.4 2.5-5.4 5.3 0 1 .3 1.7.8 2.3.1.1.1.2.1.3l-.3 1.1c0 .2-.1.2-.3.1-1.2-.5-1.8-1.9-1.8-3.5 0-2.6 2.2-5.8 6.5-5.8 3.5 0 5.8 2.5 5.8 5.2 0 3.6-2 6.2-5 6.2-1 0-1.9-.5-2.2-1.2l-.6 2.3c-.2.8-.8 1.8-1.2 2.4 1 .3 2 .4 3.1.4 5 0 8.5-3.5 8.5-8.8C20.5 6.5 16.9 3 12 3z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ger-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Footer",
  "tag": "section",
  "class": "ger-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Leave empty to use the original GR logo asset."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "GULSHAN-E-REHMAT"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Elegance in Every Thread"
    },
    {
      "type": "text",
      "id": "women_heading",
      "label": "Women column heading",
      "default": "SHOP WOMEN"
    },
    {
      "type": "text",
      "id": "men_heading",
      "label": "Men column heading",
      "default": "SHOP MEN"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Customer care heading",
      "default": "CUSTOMER CARE"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "women_link",
      "name": "Women link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Unstitched" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "men_link",
      "name": "Men link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Summer Collection" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "care_link",
      "name": "Care link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Contact Us" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Footer",
      "blocks": [
        { "type": "women_link", "settings": { "label": "Unstitched" } },
        { "type": "women_link", "settings": { "label": "Ready to Wear" } },
        { "type": "women_link", "settings": { "label": "Wedding Collection" } },
        { "type": "women_link", "settings": { "label": "Abaya Collection" } },
        { "type": "men_link", "settings": { "label": "Summer Collection" } },
        { "type": "men_link", "settings": { "label": "Winter Collection" } },
        { "type": "men_link", "settings": { "label": "Waist Coats" } },
        { "type": "care_link", "settings": { "label": "Contact Us" } },
        { "type": "care_link", "settings": { "label": "Shipping Policy" } },
        { "type": "care_link", "settings": { "label": "Returns & Exchange" } },
        { "type": "care_link", "settings": { "label": "Privacy Policy" } }
      ]
    }
  ]
}
{% endschema %}
