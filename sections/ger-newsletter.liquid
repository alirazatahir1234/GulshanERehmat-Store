{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-newsletter" {{ section.shopify_attributes }}>
  <div class="ger-container">
    <div class="ger-newsletter__header ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-heading ger-heading--md">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ger-text" style="margin-top: 0.75rem;">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% form 'customer', class: 'ger-newsletter__form ger-fade-in' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="GerNewsletterEmail-{{ section.id }}">Email</label>
      <input
        id="GerNewsletterEmail-{{ section.id }}"
        class="ger-newsletter__input"
        type="email"
        name="contact[email]"
        value="{% if form.email %}{{ form.email }}{% endif %}"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocomplete="email"
      >
      <button type="submit" class="ger-btn ger-btn--primary">
        {{ section.settings.button_label }}
      </button>

      {% if form.posted_successfully? %}
        <p class="ger-newsletter__message ger-newsletter__message--success" style="width: 100%;">
          {{ section.settings.success_message }}
        </p>
      {% endif %}
      {% if form.errors %}
        <p class="ger-newsletter__message" style="width: 100%;">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "GER Newsletter",
  "tag": "section",
  "class": "ger-newsletter-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Newsletter"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Be first to know about new arrivals, exclusive drops, and fabric stories."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "GER Newsletter"
    }
  ]
}
{% endschema %}
