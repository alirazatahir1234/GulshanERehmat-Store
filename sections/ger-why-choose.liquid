{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-why" {{ section.shopify_attributes }}>
  <div class="ger-container">
    <div class="ger-why__header ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-heading ger-heading--md">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ger-text" style="margin-top: 0.75rem;">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="ger-why__grid">
      {% for block in section.blocks %}
        <div class="ger-why-card ger-fade-in" {{ block.shopify_attributes }}>
          {% if block.settings.number != blank %}
            <p class="ger-why-card__num">{{ block.settings.number }}</p>
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="ger-why-card__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ger-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Why choose us",
  "tag": "section",
  "class": "ger-why-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Crafted with care for those who value quality and tradition."
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Authentic fabrics"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Sourced and selected for lasting beauty and comfort."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Why choose us",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "number": "01",
            "title": "Authentic fabrics",
            "text": "Sourced and selected for lasting beauty and comfort."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "02",
            "title": "Timeless design",
            "text": "Pieces that honour tradition while feeling contemporary."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "03",
            "title": "Trusted service",
            "text": "Careful packing, clear communication, and easy returns."
          }
        }
      ]
    }
  ]
}
{% endschema %}
