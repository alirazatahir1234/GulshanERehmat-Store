{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-lookbook" {{ section.shopify_attributes }}>
  <div class="ger-container">
    <div class="ger-lookbook__header ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-heading ger-heading--md">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ger-text" style="margin-top: 0.75rem;">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="ger-lookbook__grid">
      {% for block in section.blocks %}
        {% liquid
          assign item_class = 'ger-lookbook__item'
          if block.settings.size == 'tall'
            assign item_class = item_class | append: ' ger-lookbook__item--tall'
          elsif block.settings.size == 'wide'
            assign item_class = item_class | append: ' ger-lookbook__item--wide'
          endif
        %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="{{ item_class }} ger-fade-in" {{ block.shopify_attributes }}>
        {% else %}
          <div class="{{ item_class }} ger-fade-in" {{ block.shopify_attributes }}>
        {% endif %}
          <div class="ger-img-zoom">
            {% if block.settings.image != blank %}
              {% liquid
                assign look_alt = block.settings.alt
                if look_alt == blank
                  assign look_alt = section.settings.heading
                endif
              %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 25vw, 50vw', alt: look_alt
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Lookbook",
  "tag": "section",
  "class": "ger-lookbook-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inspiration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lookbook"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Styled moments from our latest collections."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "tall", "label": "Tall" },
            { "value": "wide", "label": "Wide" }
          ],
          "default": "standard"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Lookbook",
      "blocks": [
        { "type": "image", "settings": { "size": "tall" } },
        { "type": "image", "settings": { "size": "standard" } },
        { "type": "image", "settings": { "size": "standard" } },
        { "type": "image", "settings": { "size": "wide" } },
        { "type": "image", "settings": { "size": "standard" } },
        { "type": "image", "settings": { "size": "standard" } }
      ]
    }
  ]
}
{% endschema %}
