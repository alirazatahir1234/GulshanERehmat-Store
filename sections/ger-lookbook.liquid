{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-lookbook" {{ section.shopify_attributes }}>
  <div class="ger-container ger-lookbook__wrap">
    <div class="ger-lookbook__header ger-fade-in">
      <div class="ger-lookbook__intro">
        {% if section.settings.heading != blank %}
          <h2 class="ger-lookbook__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="ger-lookbook__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="ger-lookbook__cta"
        >
          <span>{{ section.settings.button_label }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ger-lookbook__gallery">
    {% for block in section.blocks %}
      {% liquid
        assign look_alt = block.settings.alt
        if look_alt == blank
          assign look_alt = section.settings.heading | append: ' look ' | append: forloop.index
        endif
        assign fallback_index = forloop.index
        if fallback_index > 6
          assign fallback_index = fallback_index | modulo: 6
          if fallback_index == 0
            assign fallback_index = 6
          endif
        endif
        assign fallback_asset = 'ger-lookbook-' | append: fallback_index | append: '.jpg'
        assign item_url = block.settings.link
      %}
      {% if item_url != blank %}
        <a
          href="{{ item_url }}"
          class="ger-lookbook__item ger-fade-in"
          {{ block.shopify_attributes }}
        >
      {% else %}
        <div class="ger-lookbook__item ger-fade-in" {{ block.shopify_attributes }}>
      {% endif %}
        <div class="ger-lookbook__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '280, 400, 600, 900',
                sizes: '(min-width: 990px) 16.6vw, (min-width: 750px) 33vw, 50vw',
                alt: look_alt,
                class: 'ger-lookbook__img'
            }}
          {% else %}
            <img
              class="ger-lookbook__img"
              src="{{ fallback_asset | asset_url }}"
              alt="{{ look_alt | escape }}"
              width="600"
              height="900"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% if item_url != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "GER Lookbook",
  "tag": "section",
  "class": "ger-lookbook-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Lookbook"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real Fabrics. Real Style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE LOOKBOOK"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Lookbook",
      "blocks": [
        { "type": "image", "settings": { "alt": "Navy floral suit" } },
        { "type": "image", "settings": { "alt": "Red and cream floral suit" } },
        { "type": "image", "settings": { "alt": "Navy gold embroidered suit" } },
        { "type": "image", "settings": { "alt": "Sage green embroidered suit" } },
        { "type": "image", "settings": { "alt": "Blue and white printed suit" } },
        { "type": "image", "settings": { "alt": "Purple floral suit" } }
      ]
    }
  ]
}
{% endschema %}
