{%- liquid
  assign product = product
  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif
  assign product_form_id = 'GerProductForm-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
-%}

<section
  id="GerProduct-{{ section.id }}"
  class="ger-pdp"
  data-ger-pdp
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="ger-pdp__shell">
    <nav class="ger-pdp__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {%- if product.collections.size > 0 -%}
        <span aria-hidden="true">›</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
      <span aria-hidden="true">›</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="ger-pdp__grid">
      <div class="ger-pdp__col-gallery">
        {% render 'ger-product-gallery', product: product, section_id: section.id %}
      </div>
      <div class="ger-pdp__col-info">
        {% render 'ger-product-form', product: product, section_id: section.id, product_form_id: product_form_id %}
        {% render 'ger-product-accordions', product: product %}
      </div>
    </div>
  </div>

  {%- comment -%} Sticky mobile ATC bar {%- endcomment -%}
  <div class="ger-pdp__sticky-bar" data-ger-sticky-bar hidden>
    <div class="ger-pdp__sticky-left">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 96
          | image_tag: loading: 'lazy', class: 'ger-pdp__sticky-thumb', alt: product.title | escape
        }}
      {%- endif -%}
      <div>
        <p class="ger-pdp__sticky-title">{{ product.title | truncate: 42 }}</p>
        <p class="ger-pdp__sticky-price" data-ger-sticky-price>{{ current_variant.price | money }}</p>
      </div>
    </div>
    <button
      type="button"
      class="ger-pdp__btn ger-pdp__btn--bag ger-pdp__sticky-atc"
      data-ger-sticky-atc
      {% unless current_variant.available %}disabled{% endunless %}
    >
      ADD TO BAG
    </button>
  </div>

  {%- comment -%} Lightbox {%- endcomment -%}
  <div class="ger-pdp__lightbox" data-ger-lightbox hidden>
    <button type="button" class="ger-pdp__lightbox-close" data-ger-lightbox-close aria-label="Close gallery">×</button>
    <button type="button" class="ger-pdp__lightbox-nav ger-pdp__lightbox-nav--prev" data-ger-lightbox-nav="-1" aria-label="Previous">‹</button>
    <img class="ger-pdp__lightbox-img" data-ger-lightbox-img alt="">
    <button type="button" class="ger-pdp__lightbox-nav ger-pdp__lightbox-nav--next" data-ger-lightbox-nav="1" aria-label="Next">›</button>
  </div>

  <script type="application/json" data-ger-product-json>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "handle": {{ product.handle | json }},
      "url": {{ product.url | json }},
      "vendor": {{ product.vendor | json }},
      "type": {{ product.type | json }},
      "featured_image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 400 | json }}{% else %}null{% endif %},
      "price": {{ current_variant.price | json }},
      "compare_at_price": {{ current_variant.compare_at_price | json }},
      "variants": {{ product.variants | json }},
      "media": [
        {%- for media in product.media -%}
          {
            "id": {{ media.id | json }},
            "src": {% if media.preview_image %}{{ media.preview_image | image_url: width: 2000 | json }}{% else %}null{% endif %},
            "thumb": {% if media.preview_image %}{{ media.preview_image | image_url: width: 200 | json }}{% else %}null{% endif %},
            "alt": {{ media.alt | default: product.title | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "GER Product",
  "tag": "section",
  "class": "ger-product-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Premium Gulshan E Rehmat product detail layout. Header and footer stay unchanged."
    },
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "Show sticky mobile add to bag bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "GER Product"
    }
  ]
}
{% endschema %}
