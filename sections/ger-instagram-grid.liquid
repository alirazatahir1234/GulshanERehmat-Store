{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-instagram" {{ section.shopify_attributes }}>
  <div class="ger-container">
    <div class="ger-instagram__header ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-heading ger-heading--md">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.profile_handle != blank %}
        <a
          href="{{ section.settings.profile_url | default: 'https://www.instagram.com/' }}"
          class="ger-instagram__handle"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.profile_handle }}
        </a>
      {% endif %}
    </div>

    <div class="ger-instagram__grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            class="ger-instagram__item ger-img-zoom ger-fade-in"
            target="_blank"
            rel="noopener noreferrer"
            {{ block.shopify_attributes }}
          >
        {% else %}
          <div class="ger-instagram__item ger-img-zoom ger-fade-in" {{ block.shopify_attributes }}>
        {% endif %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 25vw, 50vw', alt: section.settings.heading
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Instagram grid",
  "tag": "section",
  "class": "ger-instagram-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Follow along"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On Instagram"
    },
    {
      "type": "text",
      "id": "profile_handle",
      "label": "Profile handle",
      "default": "@gulshanerehmat"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Instagram grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
