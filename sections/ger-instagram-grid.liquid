{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-instagram" {{ section.shopify_attributes }}>
  <div class="ger-container ger-instagram__wrap">
    <div class="ger-instagram__header ger-fade-in">
      {% if section.settings.heading != blank %}
        <h2 class="ger-instagram__heading">
          {% if section.settings.profile_url != blank %}
            <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener noreferrer">
              {{ section.settings.heading }}
            </a>
          {% else %}
            {{ section.settings.heading }}
          {% endif %}
        </h2>
      {% endif %}
    </div>
  </div>

  <div class="ger-instagram__grid">
    {% for block in section.blocks %}
      {% liquid
        assign fallback_index = forloop.index
        if fallback_index > 8
          assign fallback_index = fallback_index | modulo: 8
          if fallback_index == 0
            assign fallback_index = 8
          endif
        endif
        assign fallback_asset = 'ger-ig-' | append: fallback_index | append: '.jpg'
      %}
      {% if block.settings.link != blank %}
        <a
          href="{{ block.settings.link }}"
          class="ger-instagram__item ger-fade-in"
          target="_blank"
          rel="noopener noreferrer"
          {{ block.shopify_attributes }}
        >
      {% else %}
        <div class="ger-instagram__item ger-fade-in" {{ block.shopify_attributes }}>
      {% endif %}
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '240, 400, 600, 800',
              sizes: '(min-width: 990px) 12.5vw, (min-width: 750px) 25vw, 50vw',
              alt: section.settings.heading,
              class: 'ger-instagram__img'
          }}
        {% else %}
          <img
            class="ger-instagram__img"
            src="{{ fallback_asset | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            width="600"
            height="600"
            loading="lazy"
          >
        {% endif %}
      {% if block.settings.link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.profile_url != blank and section.settings.button_label != blank %}
    <div class="ger-container ger-instagram__cta-wrap ger-fade-in">
      <a
        href="{{ section.settings.profile_url }}"
        class="ger-instagram__cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "GER Instagram grid",
  "tag": "section",
  "class": "ger-instagram-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us @GulshanERehmat"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Follow button label",
      "default": "FOLLOW ON INSTAGRAM"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GER Instagram grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
