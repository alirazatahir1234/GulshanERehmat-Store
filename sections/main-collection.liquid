

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% if template.name == 'collection' %}
  {{ 'ger-collection.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ger-collection.js' | asset_url }}" defer></script>
{% endif %}

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{%- liquid
  assign kafoor_page = false
  assign wash_wear_parent = false
  assign summer_fabric_page = false
  assign ger_plp_master = false
  assign ger_plp_label = collection.title
  assign ger_plp_subtitle = 'Premium Fabrics for Every Occasion'
  assign handle = collection.handle | default: ''

  if handle == 'men-wash-n-wear-kafoor-by-taiba' or handle == 'men-wash-n-wear-kafoor-by-taiba-life-line' or handle contains 'kafoor-by-taiba'
    assign kafoor_page = true
  endif

  if handle == 'men-summer-wash-n-wear' or handle == 'men-wash-n-wear' or handle == 'wash-n-wear' or handle == 'wash-and-wear'
    assign wash_wear_parent = true
    assign summer_fabric_page = true
    assign ger_plp_label = 'Wash & Wear'
    assign ger_plp_subtitle = 'Premium Fabrics for Every Occasion'
  endif

  if handle == 'men-summer-cotton'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Cotton'
    assign ger_plp_subtitle = 'Soft Everyday Essentials'
  endif

  if handle == 'men-summer-lawn'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Lawn'
    assign ger_plp_subtitle = 'Light & Breathable Fabrics'
  endif

  if handle == 'men-summer-imported'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Imported'
    assign ger_plp_subtitle = 'Curated International Fabrics'
  endif

  if handle == 'men-summer-embroidered'
    assign summer_fabric_page = true
    assign ger_plp_label = 'Embroidered Collection'
    assign ger_plp_subtitle = 'Detailed Craft for Special Occasions'
  endif

  if wash_wear_parent == false and kafoor_page == false and summer_fabric_page == false
    assign title_down = collection.title | downcase | default: ''
    if title_down contains 'wash' and title_down contains 'wear'
      unless title_down contains 'kafoor' or title_down contains 'life line'
        assign wash_wear_parent = true
        assign summer_fabric_page = true
        assign ger_plp_label = 'Wash & Wear'
      endunless
    endif
  endif

  if summer_fabric_page and kafoor_page == false
    assign ger_plp_master = true
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component
  class="ger-collection-page ger-collection-page--sidebar{% if ger_plp_master %} ger-collection-page--wash{% endif %}"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container ger-collection-page ger-collection-page--sidebar{% if ger_plp_master %} ger-collection-page--wash{% endif %}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% liquid
      comment
        Estimate exploded color-card count for toolbar (1 Product · N Colors).
        Skips unmatched variants so active Color filters keep the count honest.
        JS refreshes from the live grid after AJAX facet updates.
      endcomment
      assign ger_color_card_count = 0
      assign ger_has_exploded_colors = false
      for product in collection.products
        assign color_option_position = blank
        for option in product.options_with_values
          assign option_name = option.name | downcase | strip
          if option_name == 'color' or option_name == 'colour' or option_name == 'shade'
            assign color_option_position = forloop.index0
            break
          endif
        endfor

        if color_option_position != blank and product.variants.size > 1
          assign ger_has_exploded_colors = true
          assign seen_colors = '|'
          for variant in product.variants
            if variant.matched == false
              continue
            endif
            case color_option_position
              when 0
                assign color_name = variant.option1
              when 1
                assign color_name = variant.option2
              when 2
                assign color_name = variant.option3
              else
                assign color_name = variant.title
            endcase
            assign color_key = color_name | handleize
            assign color_token = color_key | prepend: '|' | append: '|'
            unless seen_colors contains color_token
              assign seen_colors = seen_colors | append: color_key | append: '|'
              assign ger_color_card_count = ger_color_card_count | plus: 1
            endunless
          endfor
        else
          assign ger_color_card_count = ger_color_card_count | plus: 1
        endif
      endfor
    %}

    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
      data-ger-products-count="{{ collection.products_count }}"
      data-ger-color-count="{{ ger_color_card_count }}"
      data-ger-has-exploded-colors="{% if ger_has_exploded_colors %}true{% else %}false{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count,
        ger_color_count: ger_color_card_count,
        ger_has_exploded_colors: ger_has_exploded_colors
      %}

      {% liquid
        assign products_per_page = section.settings.products_per_page | default: 12
        if section.settings.enable_infinite_scroll
          assign products_per_page = 24
        endif
        if products_per_page < 12
          assign products_per_page = 12
        endif
      %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            {% liquid
              assign color_option_position = blank
              for option in product.options_with_values
                assign option_name = option.name | downcase | strip
                if option_name == 'color' or option_name == 'colour' or option_name == 'shade'
                  assign color_option_position = forloop.index0
                  break
                endif
              endfor

              comment
                Show one card per Color so fabric collections with few products
                still fill the grid (e.g. Life Line with many shades).
              endcomment
              assign explode_colors = false
              if color_option_position != blank and product.variants.size > 1
                assign explode_colors = true
              endif
            %}

            {% if explode_colors %}
              {% render 'ger-collection-product-items',
                product: product,
                section: section,
                paginate: paginate,
                product_index: forloop.index0,
                color_option_position: color_option_position
              %}
            {% elsif ger_plp_master %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }} ger-plp-card-item"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% render 'ger-collection-product-card', product: product %}
              </li>
            {% else %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </li>
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 12,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
