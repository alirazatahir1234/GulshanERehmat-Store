{{ 'ger-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ger-homepage.js' | asset_url }}" defer></script>

<section class="ger-section ger-promo ger-promo--suite" {{ section.shopify_attributes }}>
  <div class="ger-promo__bg">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.heading,
          class: 'ger-promo__bg-img'
      }}
    {% else %}
      <img
        class="ger-promo__bg-img"
        src="{{ 'ger-promo-banner.jpg' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2400"
        height="940"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="ger-container ger-promo__inner">
    <div class="ger-promo__copy ger-fade-in">
      {% if section.settings.eyebrow != blank %}
        <p class="ger-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ger-promo__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ger-promo__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="ger-promo__cta"
        >
          <span>{{ section.settings.button_label }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GER Promo banner",
  "tag": "section",
  "class": "ger-promo-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unstitched Suit Collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Endless Combinations Same Timeless Elegance"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Leave blank to use the built-in fabric banner"
    }
  ],
  "presets": [
    {
      "name": "GER Promo banner",
      "settings": {
        "heading": "Unstitched Suit Collection",
        "text": "Endless Combinations Same Timeless Elegance",
        "button_label": "EXPLORE NOW"
      }
    }
  ]
}
{% endschema %}
