{%- doc -%}
  Single collection card for one product Color variant.
  Links to the existing product URL with that variant preselected.

  @param {object} product - Parent product
  @param {object} variant - Color variant to display
  @param {string} color_name - Display color label
{%- enddoc -%}

{%- liquid
  assign card_image = variant.featured_image
  if card_image == blank
    assign card_image = variant.image
  endif
  if card_image == blank and product.featured_media != blank
    assign card_image = product.featured_media.preview_image
  endif

  assign variant_url = variant.url
  if variant_url == blank
    assign variant_url = product.url | append: '?variant=' | append: variant.id
  endif

  assign display_title = product.title
  if product.vendor != blank
    assign vendor_prefix = product.vendor | append: ' '
    if display_title contains product.vendor
      assign display_title = display_title | replace_first: vendor_prefix, '' | strip
    endif
  endif

  assign is_on_sale = false
  if variant.compare_at_price > variant.price
    assign is_on_sale = true
  endif

  assign show_go_badge = false
  if settings.grand_opening_enabled
    if is_on_sale
      assign show_go_badge = true
    endif
    if product.tags contains 'grand-opening' or product.tags contains 'Grand Opening' or product.tags contains 'GRAND OPENING'
      assign show_go_badge = true
    endif
  endif

  assign badge_label = settings.grand_opening_badge_label | default: 'GRAND OPENING'
  assign wishlist_key = product.id | append: '-' | append: variant.id
  assign card_available = variant.available
-%}

<article
  class="product-card ger-variant-card{% unless card_available %} ger-variant-card--sold-out{% endunless %}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ variant.id }}"
>
  <div class="product-card__content product-grid__card layout-panel-flex layout-panel-flex--column">
    <div class="card-gallery ger-variant-card__gallery">
      <a href="{{ variant_url }}" class="ger-variant-card__media-link">
        {% if card_image != blank %}
          {{
            card_image
            | image_url: width: 900
            | image_tag:
              class: 'ger-variant-card__img',
              loading: 'lazy',
              widths: '280, 400, 560, 720, 900',
              sizes: '(min-width: 1200px) 30vw, (min-width: 750px) 45vw, 50vw',
              alt: display_title | append: ' — ' | append: color_name
          }}
        {% else %}
          <div class="ger-variant-card__placeholder" aria-hidden="true"></div>
        {% endif %}
      </a>

      <div class="ger-product-card-overlay">
        {% if show_go_badge %}
          <span class="ger-product-card-overlay__badge">{{ badge_label }}</span>
        {% elsif card_available == false %}
          <span class="ger-product-card-overlay__badge ger-product-card-overlay__badge--sold-out">Sold out</span>
        {% endif %}
        <button
          type="button"
          class="ger-product-card-overlay__wishlist"
          data-ger-wishlist
          data-wishlist-key="{{ wishlist_key }}"
          aria-label="Add {{ display_title | escape }} {{ color_name | escape }} to wishlist"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="ger-variant-card__body">
      {% if product.vendor != blank %}
        <p class="ger-product-brand">{{ product.vendor }}</p>
      {% endif %}

      <h3 class="ger-variant-card__title">
        <a href="{{ variant_url }}">{{ display_title }}</a>
      </h3>

      {% if color_name != blank %}
        <p class="ger-variant-card__color">{{ color_name }}</p>
      {% endif %}

      <div class="ger-variant-card__price price">
        {% if is_on_sale %}
          <s class="compare-at-price">
            {% if settings.currency_code_enabled_product_cards %}
              {{ variant.compare_at_price | money_with_currency }}
            {% else %}
              {{ variant.compare_at_price | money }}
            {% endif %}
          </s>
          <span class="price-item price-item--sale">
            {% if settings.currency_code_enabled_product_cards %}
              {{ variant.price | money_with_currency }}
            {% else %}
              {{ variant.price | money }}
            {% endif %}
          </span>
        {% else %}
          <span class="price-item">
            {% if settings.currency_code_enabled_product_cards %}
              {{ variant.price | money_with_currency }}
            {% else %}
              {{ variant.price | money }}
            {% endif %}
          </span>
        {% endif %}
      </div>

      <div class="ger-variant-card__actions">
        {%- assign atc_form_id = 'ger-atc-' | append: product.id | append: '-' | append: variant.id -%}
        <form
          id="{{ atc_form_id }}"
          class="ger-variant-card__form buy-buttons-block"
          method="post"
          action="{{ routes.cart_add_url }}"
          accept-charset="UTF-8"
          enctype="multipart/form-data"
          data-ger-variant-atc
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            name="add"
            class="add-to-cart-button"
            {% unless card_available %}
              disabled
              aria-disabled="true"
            {% endunless %}
          >
            {% if card_available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </button>
        </form>
      </div>
    </div>
  </div>
</article>
