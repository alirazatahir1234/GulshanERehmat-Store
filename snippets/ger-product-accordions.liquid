{%- doc -%}
  GER PDP: trust accordions + product information tabs (no long duplicated description dump).
  @param {object} product - Product object
{%- enddoc -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign price = current_variant.price
  assign compare_at = current_variant.compare_at_price
  assign on_sale = false
  assign save_amount = 0
  assign save_pct = 0
  if compare_at != blank and compare_at > price
    assign on_sale = true
    assign save_amount = compare_at | minus: price
    assign save_pct = save_amount | times: 100.0 | divided_by: compare_at | round
  endif

  assign brand_name = product.vendor | default: 'Kafoor by Taiba'
  assign collection_name = 'Life Line'
  if product.collections.size > 0
    assign collection_name = product.collections.first.title
  endif
-%}

<div class="ger-pdp__panels">
  <div class="ger-pdp__mini-accordions">
    <details class="ger-pdp__mini-acc">
      <summary>
        <span class="ger-pdp__mini-icon" aria-hidden="true">🚚</span>
        <span>Delivery Information</span>
        <span class="ger-pdp__plus" aria-hidden="true"></span>
      </summary>
      <div class="ger-pdp__mini-body">
        <p>Nationwide Pakistan delivery. Shipping timelines vary by city.</p>
      </div>
    </details>
    <details class="ger-pdp__mini-acc">
      <summary>
        <span class="ger-pdp__mini-icon" aria-hidden="true">↻</span>
        <span>Returns &amp; Exchange</span>
        <span class="ger-pdp__plus" aria-hidden="true"></span>
      </summary>
      <div class="ger-pdp__mini-body">
        <p>Returns and exchanges follow our <a href="/policies/refund-policy">Refund &amp; Exchange Policy</a>.</p>
      </div>
    </details>
    <details class="ger-pdp__mini-acc">
      <summary>
        <span class="ger-pdp__mini-icon" aria-hidden="true">🔒</span>
        <span>Secure Payment</span>
        <span class="ger-pdp__plus" aria-hidden="true"></span>
      </summary>
      <div class="ger-pdp__mini-body">
        <p>Secure checkout with trusted payment methods.</p>
      </div>
    </details>
  </div>

  <div class="ger-pdp__tabs" data-ger-product-tabs>
    <div class="ger-pdp__tabs-header" role="tablist" aria-label="Product information">
      <button type="button" class="ger-pdp__tab is-active" role="tab" aria-selected="true" data-ger-tab="highlights" id="GerTab-highlights">Product Highlights</button>
      <button type="button" class="ger-pdp__tab" role="tab" aria-selected="false" data-ger-tab="details" id="GerTab-details">Product Details</button>
      <button type="button" class="ger-pdp__tab" role="tab" aria-selected="false" data-ger-tab="ideal" id="GerTab-ideal">Ideal For</button>
      <button type="button" class="ger-pdp__tab" role="tab" aria-selected="false" data-ger-tab="offer" id="GerTab-offer">Grand Opening</button>
      <button type="button" class="ger-pdp__tab" role="tab" aria-selected="false" data-ger-tab="why" id="GerTab-why">Why Choose Life Line?</button>
      <button type="button" class="ger-pdp__tab" role="tab" aria-selected="false" data-ger-tab="delivery" id="GerTab-delivery">Delivery &amp; Care</button>
    </div>

    <div class="ger-pdp__tabs-panels">
      <div class="ger-pdp__tab-panel is-active" role="tabpanel" data-ger-tab-panel="highlights" aria-labelledby="GerTab-highlights">
        <ul class="ger-pdp__highlight-grid">
          <li>Premium Wash &amp; Wear Fabric</li>
          <li>Extra Soft &amp; Comfortable Feel</li>
          <li>Durable &amp; Long-Lasting</li>
          <li>Elegant Finish</li>
          <li>Perfect for Daily &amp; Formal Wear</li>
          <li>Easy Care — Minimal Ironing</li>
          <li>Available in 13 Stylish Colors</li>
          <li>Trusted Quality by Kafoor by Taiba</li>
        </ul>
      </div>

      <div class="ger-pdp__tab-panel" role="tabpanel" data-ger-tab-panel="details" aria-labelledby="GerTab-details" hidden>
        <dl class="ger-pdp__specs ger-pdp__specs--table">
          <div><dt>Brand</dt><dd>{{ brand_name }}</dd></div>
          <div><dt>Collection</dt><dd>{{ collection_name }}</dd></div>
          <div><dt>Fabric Type</dt><dd>Premium Men’s Wash &amp; Wear</dd></div>
          <div><dt>Recommended For</dt><dd>Shalwar Kameez</dd></div>
          <div><dt>Care</dt><dd>Easy Wash &amp; Wear</dd></div>
          <div><dt>Colors</dt><dd>13 Elegant Colors</dd></div>
          <div><dt>Sold By</dt><dd>Gulshan E Rehmat</dd></div>
        </dl>
      </div>

      <div class="ger-pdp__tab-panel" role="tabpanel" data-ger-tab-panel="ideal" aria-labelledby="GerTab-ideal" hidden>
        <ul class="ger-pdp__ideal-list">
          <li>
            <strong>Jummah &amp; Religious Wear</strong>
            <span>Comfortable all-day fabric for prayers and gatherings.</span>
          </li>
          <li>
            <strong>Eid &amp; Festive Wear</strong>
            <span>An elegant finish for celebrations and family events.</span>
          </li>
          <li>
            <strong>Office &amp; Professional Wear</strong>
            <span>Refined Wash &amp; Wear suitable for everyday work looks.</span>
          </li>
          <li>
            <strong>Weddings &amp; Formal Events</strong>
            <span>A polished option for formal occasions.</span>
          </li>
          <li>
            <strong>Daily &amp; Casual Wear</strong>
            <span>Soft, breathable comfort for everyday use.</span>
          </li>
          <li>
            <strong>Family Gatherings &amp; Celebrations</strong>
            <span>Reliable quality for special moments.</span>
          </li>
        </ul>
      </div>

      <div class="ger-pdp__tab-panel" role="tabpanel" data-ger-tab-panel="offer" aria-labelledby="GerTab-offer" hidden>
        <div class="ger-pdp__offer-panel">
          <h3 class="ger-pdp__offer-heading">Grand Opening Special</h3>
          {%- if on_sale -%}
            <div class="ger-pdp__offer-grid">
              <div>
                <span class="ger-pdp__offer-label">Original Price</span>
                <strong class="ger-pdp__offer-compare">{{ compare_at | money }}</strong>
              </div>
              <div>
                <span class="ger-pdp__offer-label">Grand Opening Price</span>
                <strong class="ger-pdp__offer-price">{{ price | money }}</strong>
              </div>
              <div>
                <span class="ger-pdp__offer-label">Savings</span>
                <strong>{{ save_amount | money }}</strong>
              </div>
              <div>
                <span class="ger-pdp__offer-label">Discount</span>
                <strong>{{ save_pct }}% OFF</strong>
              </div>
            </div>
          {%- else -%}
            <p class="ger-pdp__offer-note">Current price: <strong>{{ price | money }}</strong></p>
          {%- endif -%}
        </div>
      </div>

      <div class="ger-pdp__tab-panel" role="tabpanel" data-ger-tab-panel="why" aria-labelledby="GerTab-why" hidden>
        <ul class="ger-pdp__why-grid">
          <li>
            <strong>Comfort for the day</strong>
            <span>Soft Wash &amp; Wear that stays comfortable from morning to evening.</span>
          </li>
          <li>
            <strong>Elegance for every occasion</strong>
            <span>A refined finish for both daily and formal looks.</span>
          </li>
          <li>
            <strong>Quality you can rely on</strong>
            <span>Built for durability with a premium feel.</span>
          </li>
          <li>
            <strong>Easy-care Wash &amp; Wear fabric</strong>
            <span>Simple care with minimal ironing needed.</span>
          </li>
          <li>
            <strong>Designed for the modern Pakistani man</strong>
            <span>Style, comfort, and confidence in one fabric.</span>
          </li>
          <li>
            <strong>Premium quality by Kafoor by Taiba</strong>
            <span>Trusted brand quality, available at Gulshan E Rehmat.</span>
          </li>
        </ul>
      </div>

      <div class="ger-pdp__tab-panel" role="tabpanel" data-ger-tab-panel="delivery" aria-labelledby="GerTab-delivery" hidden>
        <div class="ger-pdp__delivery-grid">
          <div>
            <h4>Delivery Information</h4>
            <ul>
              <li>Nationwide Pakistan Delivery</li>
              <li>Estimated delivery follows the store’s configured shipping policy</li>
            </ul>
          </div>
          <div>
            <h4>Care Instructions</h4>
            <ul>
              <li>Easy Wash &amp; Wear</li>
              <li>Follow the recommended fabric-care instructions on the product</li>
            </ul>
          </div>
          <div>
            <h4>Returns &amp; Exchange</h4>
            <ul>
              <li>Handled under our existing <a href="/policies/refund-policy">Returns &amp; Exchange policy</a></li>
            </ul>
          </div>
          <div>
            <h4>Payment</h4>
            <ul>
              <li>Secure Payment</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
