{%- doc -%}
  Returns a safe hex/CSS color for known GER / taxonomy color labels.
  Outputs nothing when no mapping exists (caller should use a neutral fallback).

  @param {string} label - Color label (e.g. Blue, Powder Blue, Navy)
{%- enddoc -%}
{%- liquid
  assign key = label | downcase | strip | handleize
  assign hex = blank

  case key
    when 'black'
      assign hex = '#111111'
    when 'white'
      assign hex = '#f5f5f5'
    when 'blue'
      assign hex = '#2f5aa8'
    when 'powder-blue'
      assign hex = '#9eb8d8'
    when 'ice-blue'
      assign hex = '#c5d8e8'
    when 'navy', 'navy-blue'
      assign hex = '#1a2a4a'
    when 'green'
      assign hex = '#3d6b4f'
    when 'sage-green'
      assign hex = '#8fa88b'
    when 'olive'
      assign hex = '#6b6b3d'
    when 'yellow'
      assign hex = '#e6c84a'
    when 'mustard'
      assign hex = '#c4a035'
    when 'brown'
      assign hex = '#6b4423'
    when 'taupe'
      assign hex = '#8b7d6b'
    when 'stone'
      assign hex = '#a8a090'
    when 'gray', 'grey'
      assign hex = '#7a7a7a'
    when 'light-grey', 'light-gray'
      assign hex = '#c4c4c4'
    when 'charcoal'
      assign hex = '#3a3a3a'
    when 'red'
      assign hex = '#b91c1c'
    when 'pink'
      assign hex = '#d81b70'
    when 'maroon'
      assign hex = '#7a1f2b'
    when 'beige'
      assign hex = '#d4c4a8'
    when 'cream'
      assign hex = '#f5f0e6'
    when 'orange'
      assign hex = '#d97706'
    when 'purple'
      assign hex = '#6b3fa0'
    when 'teal'
      assign hex = '#0f766e'
  endcase
-%}
{{- hex -}}
