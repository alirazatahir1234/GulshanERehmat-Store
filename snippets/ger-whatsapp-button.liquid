{%- doc -%}
  Floating circular WhatsApp chat button for Gulshan E Rehmat.
{%- enddoc -%}

{%- liquid
  assign wa_number = '923338709009'
  assign wa_text = 'Hello Gulshan E Rehmat, I need help.' | url_encode
  assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

<a
  href="{{ wa_href }}"
  class="ger-whatsapp"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Gulshan E Rehmat on WhatsApp"
>
  <span class="ger-whatsapp__icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 3C8.82 3 3 8.82 3 16c0 2.29.6 4.52 1.74 6.48L3 29l6.68-1.71A12.9 12.9 0 0 0 16 29c7.18 0 13-5.82 13-13S23.18 3 16 3zm0 23.67c-2.04 0-4.03-.55-5.77-1.6l-.41-.24-3.96 1.01 1.06-3.86-.27-.4A10.64 10.64 0 1 1 16 26.67zm5.84-7.98c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1.01 1.25-.18.21-.37.24-.68.08-1.86-.93-3.08-1.66-4.31-3.77-.33-.57.33-.53.94-1.77.1-.21.05-.39-.03-.55-.08-.16-.71-1.71-.97-2.34-.26-.62-.53-.54-.71-.55h-.61c-.21 0-.55.08-.84.39-.29.32-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.23 3.4 5.4 4.77.75.32 1.34.51 1.8.65.76.24 1.45.21 2 .13.61-.09 1.89-.77 2.16-1.51.26-.74.26-1.37.18-1.51-.08-.13-.29-.21-.61-.37z"/>
    </svg>
  </span>
  <span class="ger-whatsapp__label">WhatsApp Us</span>
</a>

{% stylesheet %}
  .ger-whatsapp {
    --ger-wa-size: 3.5rem;
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: var(--ger-wa-size);
    height: var(--ger-wa-size);
    padding: 0;
    overflow: hidden;
    border-radius: 999px;
    background: linear-gradient(180deg, #2fe075 0%, #25d366 48%, #1ebe57 100%);
    color: #ffffff;
    border: 2px solid rgba(216, 27, 112, 0.55);
    box-shadow:
      0 8px 22px rgba(37, 211, 102, 0.35),
      0 4px 12px rgba(0, 0, 0, 0.18);
    text-decoration: none;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    transition:
      width 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      gap 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .ger-whatsapp__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #ffffff;
  }

  .ger-whatsapp__label {
    max-width: 0;
    opacity: 0;
    white-space: nowrap;
    overflow: hidden;
    transition: max-width 0.3s ease, opacity 0.25s ease;
  }

  .ger-whatsapp:hover,
  .ger-whatsapp:focus-visible {
    width: auto;
    height: var(--ger-wa-size);
    padding: 0 1.15rem 0 0.85rem;
    gap: 0.55rem;
    transform: scale(1.06);
    border-color: #d81b70;
    box-shadow:
      0 12px 28px rgba(37, 211, 102, 0.4),
      0 6px 16px rgba(0, 0, 0, 0.2);
  }

  .ger-whatsapp:hover .ger-whatsapp__label,
  .ger-whatsapp:focus-visible .ger-whatsapp__label {
    max-width: 9rem;
    opacity: 1;
  }

  @media (max-width: 749px) {
    .ger-whatsapp {
      --ger-wa-size: 3.25rem;
      right: 18px;
      bottom: 18px;
    }

    /* Keep compact on touch — no expand on hover */
    .ger-whatsapp:hover,
    .ger-whatsapp:focus-visible {
      width: var(--ger-wa-size);
      padding: 0;
      gap: 0;
      transform: scale(1.05);
    }

    .ger-whatsapp:hover .ger-whatsapp__label,
    .ger-whatsapp:focus-visible .ger-whatsapp__label {
      max-width: 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ger-whatsapp,
    .ger-whatsapp__label {
      transition: none;
    }
  }
{% endstylesheet %}
