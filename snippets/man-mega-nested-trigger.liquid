{%- doc -%}
  Nested submenu trigger for Man mega menu.
  Links to the collection when it exists; otherwise a button (no 404).

  @param {string} nested_id - Matches data-nested-panel id
  @param {string} label - Visible label
  @param {string} [handle] - Optional collection handle for parent link
  @param {boolean} [default_open] - Pre-select / expand this nest on load

  @example
  {% render 'man-mega-nested-trigger', nested_id: 'wash-brands', label: 'Wash n Wear', handle: 'men-wash-n-wear' %}
{%- enddoc -%}

{% liquid
  assign col = nil
  if handle != blank
    assign col = collections[handle]
  endif

  assign trigger_class = 'man-mega-menu__nested-trigger'
  if default_open
    assign trigger_class = trigger_class | append: ' is-active is-nested-open'
  endif

  assign expanded = 'false'
  if default_open
    assign expanded = 'true'
  endif
%}
{% if col != blank %}
  <a
    href="{{ col.url }}"
    class="{{ trigger_class }}"
    data-nested-trigger="{{ nested_id }}"
    aria-expanded="{{ expanded }}"
    aria-controls="man-nested-{{ nested_id }}"
  >
    {{ label }}
  </a>
{% else %}
  <button
    type="button"
    class="{{ trigger_class }}"
    data-nested-trigger="{{ nested_id }}"
    aria-expanded="{{ expanded }}"
    aria-controls="man-nested-{{ nested_id }}"
  >
    {{ label }}
  </button>
{% endif %}
