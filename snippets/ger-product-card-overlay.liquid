{%- doc -%}
  Badge + wishlist overlay for collection product cards.
  Prefers GRAND OPENING when campaign is enabled and product is on sale / tagged.

  @param {object} product - Product object
  @param {boolean} [show_new_badge] - Whether to show New badge as fallback
  @param {boolean} [enable_wishlist] - Whether to show wishlist button
{%- enddoc -%}

{%- liquid
  assign show_new = show_new_badge | default: true
  assign show_wish = enable_wishlist | default: true
  assign badge_label = blank
  assign is_on_sale = false

  if product != blank and product.compare_at_price > product.price
    assign is_on_sale = true
  endif

  assign has_go_tag = false
  if product != blank
    if product.tags contains 'grand-opening' or product.tags contains 'Grand Opening' or product.tags contains 'GRAND OPENING'
      assign has_go_tag = true
    endif
  endif

  if settings.grand_opening_enabled and product != blank
    if is_on_sale or has_go_tag
      assign badge_label = settings.grand_opening_badge_label | default: 'GRAND OPENING'
    endif
  endif

  if badge_label == blank and show_new and product != blank
    if product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' or product.tags contains 'New Arrival'
      assign badge_label = 'New'
    else
      assign now_ts = 'now' | date: '%s'
      assign created_ts = product.created_at | date: '%s'
      assign age_seconds = now_ts | minus: created_ts
      if age_seconds < 5184000
        assign badge_label = 'New'
      endif
    endif
  endif
-%}

{%- if product != blank -%}
  {%- if badge_label != blank or show_wish -%}
  <div class="ger-product-card-overlay">
    {% if badge_label != blank %}
      <span class="ger-product-card-overlay__badge">{{ badge_label }}</span>
    {% endif %}
    {% if show_wish %}
      <button
        type="button"
        class="ger-product-card-overlay__wishlist"
        data-ger-wishlist
        data-wishlist-key="{{ product.id }}"
        aria-label="Add to wishlist"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z"/>
        </svg>
      </button>
    {% endif %}
  </div>
  {%- endif -%}
{%- endif -%}
