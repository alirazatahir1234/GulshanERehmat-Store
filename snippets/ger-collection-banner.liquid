{%- comment -%}
  Kafoor by Taiba — Life Line hero slider (full-bleed artwork, no text overlays).
  Shown on Kafoor / Life Line collection handles via ger-collection-hero.
{%- endcomment -%}

<section
  class="ger-collection-banner"
  data-ger-collection-banner
  data-autoplay="0"
  aria-label="{{ collection.title | default: 'Life Line' }} banner"
>
  <div class="ger-collection-banner__viewport">
    <div class="ger-collection-banner__slide is-active" data-ger-collection-banner-slide>
      <div class="ger-collection-banner__media">
        <img
          class="ger-collection-banner__img"
          src="{{ 'ger-kafoor-life-line-banner.jpg' | asset_url }}"
          alt="Life Line by Kafoor by Taiba — Premium Men’s Wash & Wear at Gulshan E Rehmat"
          width="1024"
          height="238"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </div>
    </div>
  </div>
</section>

<script src="{{ 'ger-collection-banner.js' | asset_url }}" defer></script>
