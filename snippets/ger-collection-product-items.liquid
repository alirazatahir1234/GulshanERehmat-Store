{%- doc -%}
  Renders one collection grid item per unique Color variant.

  @param {object} product - Product with Color variants
  @param {object} section - Collection section
  @param {object} paginate - Paginate object
  @param {number} product_index - Product index on this page
  @param {number} color_option_position - 0-based Color option index
{%- enddoc -%}

{%- assign rendered_colors = '|' -%}
{%- for variant in product.variants -%}
  {%- liquid
    case color_option_position
      when 0
        assign color_name = variant.option1
      when 1
        assign color_name = variant.option2
      when 2
        assign color_name = variant.option3
      else
        assign color_name = variant.title
    endcase

    assign color_key = color_name | handleize
    assign color_token = color_key | prepend: '|' | append: '|'
    assign already_rendered = false
    if rendered_colors contains color_token
      assign already_rendered = true
    endif
  -%}

  {%- unless already_rendered -%}
    {%- assign rendered_colors = rendered_colors | append: color_key | append: '|' -%}
    <li
      id="{{ section.id }}-{{ product.id }}-{{ variant.id }}"
      class="product-grid__item product-grid__item--{{ product_index }} ger-variant-card-item"
      data-page="{{ paginate.current_page }}"
      data-product-id="{{ product.id }}"
      data-variant-id="{{ variant.id }}"
      ref="cards[]"
    >
      {% render 'ger-collection-variant-card',
        product: product,
        variant: variant,
        color_name: color_name
      %}
    </li>
  {%- endunless -%}
{%- endfor -%}
