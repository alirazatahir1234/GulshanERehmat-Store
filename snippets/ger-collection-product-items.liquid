{%- doc -%}
  Renders ONE collection grid card for a multi-color product,
  with color swatches for all unique Color variants.

  @param {object} product - Product with Color variants
  @param {object} section - Collection section
  @param {object} paginate - Paginate object
  @param {number} product_index - Product index on this page
  @param {number} color_option_position - 0-based Color option index
{%- enddoc -%}

<li
  id="{{ section.id }}-{{ product.id }}"
  class="product-grid__item product-grid__item--{{ product_index }} ger-color-product-item"
  data-page="{{ paginate.current_page }}"
  data-product-id="{{ product.id }}"
  ref="cards[]"
>
  {% render 'ger-collection-variant-card',
    product: product,
    color_option_position: color_option_position
  %}
</li>
